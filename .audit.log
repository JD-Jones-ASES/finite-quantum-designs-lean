signs.IsMaxMUBCount (HPow.hPow p k) (HAdd.hAdd (HPow.hPow p k) 1)","name":"QuantumDesigns.isMaxMUBCount_odd_prime_pow"},{"declaration":"theorem QuantumDesigns.hasCompleteMUBs_two_pow (n : Nat) (hn : LE.le 1 n) : QuantumDesigns.HasCompleteMUBs (HPow.hPow 2 n)","name":"QuantumDesigns.hasCompleteMUBs_two_pow"},{"declaration":"theorem QuantumDesigns.isMaxMUBCount_two_pow (n : Nat) (hn : LE.le 1 n) :\n  QuantumDesigns.IsMaxMUBCount (HPow.hPow 2 n) (HAdd.hAdd (HPow.hPow 2 n) 1)","name":"QuantumDesigns.isMaxMUBCount_two_pow"},{"declaration":"theorem QuantumDesigns.isMaxMUBCount_prime_pow (p k : Nat) (hp : Nat.Prime p) (hk : LE.le 1 k) :\n  QuantumDesigns.IsMaxMUBCount (HPow.hPow p k) (HAdd.hAdd (HPow.hPow p k) 1)","name":"QuantumDesigns.isMaxMUBCount_prime_pow"},{"declaration":"theorem QuantumDesigns.hasCompleteMUBs_iff_isMaxMUBCount (d : Nat) (hd : LE.le 2 d) :\n  Iff (QuantumDesigns.HasCompleteMUBs d) (QuantumDesigns.IsMaxMUBCount d (HAdd.hAdd d 1))","name":"QuantumDesigns.hasCompleteMUBs_iff_isMaxMUBCount"},{"declaration":"theorem QuantumDesigns.isMaxMUBCount_two : QuantumDesigns.IsMaxMUBCount 2 3","name":"QuantumDesigns.isMaxMUBCount_two"},{"declaration":"theorem QuantumDesigns.isMaxMUBCount_four : QuantumDesigns.IsMaxMUBCount 4 5","name":"QuantumDesigns.isMaxMUBCount_four"},{"declaration":"theorem QuantumDesigns.isMaxMUBCount_eight : QuantumDesigns.IsMaxMUBCount 8 9","name":"QuantumDesigns.isMaxMUBCount_eight"},{"declaration":"theorem QuantumDesigns.gerzon_bound {d N : Nat} {c : Real} (hc : Ne c 1) (Φ : Fin N → QuantumDesigns.StateVector d)\n  (hn : ∀ (i : Fin N), QuantumDesigns.IsNormalized (Φ i)) (ho : QuantumDesigns.HasConstantOverlapSq c Φ) :\n  LE.le N (HPow.hPow d 2)","name":"QuantumDesigns.gerzon_bound"},{"declaration":"theorem QuantumDesigns.gerzon_sharp (d N : Nat) (hd : LE.le 1 d) :\n  Exists fun Φ => And (∀ (i : Fin N), QuantumDesigns.IsNormalized (Φ i)) (QuantumDesigns.HasConstantOverlapSq 1 Φ)","name":"QuantumDesigns.gerzon_sharp"},{"declaration":"theorem QuantumDesigns.gerzon_equality {d : Nat} (hd : LE.le 2 d) {c : Real} (hc : Ne c 1)\n  (Φ : Fin (HPow.hPow d 2) → QuantumDesigns.StateVector d)\n  (hn : ∀ (i : Fin (HPow.hPow d 2)), QuantumDesigns.IsNormalized (Φ i)) (ho : QuantumDesigns.HasConstantOverlapSq c Φ) :\n  Eq c (QuantumDesigns.sicOverlapSq d)","name":"QuantumDesigns.gerzon_equality"},{"declaration":"theorem QuantumDesigns.gerzon_frame {d : Nat} (hd : LE.le 2 d) {c : Real} (hc : Ne c 1)\n  (Φ : Fin (HPow.hPow d 2) → QuantumDesigns.StateVector d)\n  (hn : ∀ (i : Fin (HPow.hPow d 2)), QuantumDesigns.IsNormalized (Φ i)) (ho : QuantumDesigns.HasConstantOverlapSq c Φ) :\n  Eq\n    (Finset.sum Finset.univ fun i =>\n      HSMul.hSMul (Inv.inv ↑d)\n        (Matrix.vecMulVec (fun k => WithLp.ofLp (Φ i) k) fun l => Star.star (WithLp.ofLp (Φ i) l)))\n    1","name":"QuantumDesigns.gerzon_frame"},{"declaration":"theorem QuantumDesigns.isSICFamily_frame {d : Nat} (hd : LE.le 2 d) (Φ : Fin (HPow.hPow d 2) → QuantumDesigns.StateVector d)\n  (h : QuantumDesigns.IsSICFamily d Φ) :\n  Eq\n    (Finset.sum Finset.univ fun i =>\n      HSMul.hSMul (Inv.inv ↑d)\n        (Matrix.vecMulVec (fun k => WithLp.ofLp (Φ i) k) fun l => Star.star (WithLp.ofLp (Φ i) l)))\n    1","name":"QuantumDesigns.isSICFamily_frame"},{"declaration":"theorem QuantumDesigns.hasSICPOVM_iff_equiangular (d : Nat) (hd : LE.le 2 d) :\n  Iff (QuantumDesigns.HasSICPOVM d)\n    (Exists fun c =>\n      And (Ne c 1)\n        (Exists fun Φ =>\n          And (∀ (i : Fin (HPow.hPow d 2)), QuantumDesigns.IsNormalized (Φ i))\n            (QuantumDesigns.HasConstantOverlapSq c Φ)))","name":"QuantumDesigns.hasSICPOVM_iff_equiangular"},{"declaration":"theorem QuantumDesigns.card_le_of_sicOverlapSq {d N : Nat} (Φ : Fin N → QuantumDesigns.StateVector d)\n  (hn : ∀ (i : Fin N), QuantumDesigns.IsNormalized (Φ i))\n  (ho : QuantumDesigns.HasConstantOverlapSq (QuantumDesigns.sicOverlapSq d) Φ) : LE.le N (HPow.hPow d 2)","name":"QuantumDesigns.card_le_of_sicOverlapSq"},{"declara